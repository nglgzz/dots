{
  "hide_mouse": "never",

  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },

  // Theme
  "buffer_font_family": "Source Code Pro",
  "buffer_font_fallbacks": ["Font Awesome 6 Free Solid"],
  "icon_theme": "Zed (Default)",
  "theme": {
    "mode": "system",
    "light": "Gruvbox Light Soft",
    "dark": "GitHub Dark Dimmed"
  },

  // Panels
  "minimap": { "show": "never" },
  "git_panel": {
    "dock": "left"
  },
  "project_panel": {
    "dock": "left",
    "hide_gitignore": true,
    "hide_root": true
  },
  "collaboration_panel": { "button": false },
  "search": { "button": false },
  "outline_panel": { "dock": "left", "expand_outlines_with_depth": 1 },

  // Editor
  "git": { "inline_blame": { "enabled": false } },
  "show_edit_predictions": true,

  // Keymap
  "vim_mode": false,
  "base_keymap": "VSCode",
  "multi_cursor_modifier": "alt",

  // Agent
  "language_models": {
    "lmstudio": {
      "api_url": "https://ai.quack.foo/v1"
    }
  },
  "agent_servers": {
    "opencode": {
      "type": "registry"
    }
  },
  "agent": {
    "dock": "right"
  },

  // Languages
  "file_types": { "toml": [".env*", ".env*"] }
}
