[user]
	name = Angelo Gazzola
	email = angelo@nglgzz.com
  signingkey = ~/.ssh/id_ed25519.pub


[alias]
	ls = log --pretty=format:\"[%h]%d%Cblue%an%Creset: %s %C(bold green)(%ar)%Creset\" --graph
	sign-all = rebase --exec 'git commit --amend --no-edit -n -S' -i --root
	sign-last = commit --amend --no-edit -n -S

[core]
  editor = nvim
  pager=LESS=-R delta "$(case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in *"default"*) echo "--light" ;; *) echo "--dark" ;; esac)"
  excludesfile = ~/.config/git/gitignore_global

[interactive]
  diffFilter = delta --color-only


# SSH / Signing
[commit]
	gpgsign = true
[gpg]
  format = ssh
[url "git@github.com:"]
	insteadOf = https://github.com/


# Branches / pull / push / rebase
[init]
	defaultBranch = main
[branch]
	sort = -committerdate
[pull]
  ff = only
[push]
  autoSetupRemote = true
  default = current
[rerere]
	enabled = true


# "git status" and "git branch" colors
[color "status"]
branch = blue
added = blue
changed = yellow
untracked = yellow
unmerged = yellow


[include]
  path = ~/.config/git/git-delta.config
