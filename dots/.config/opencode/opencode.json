{
  "$schema": "https://opencode.ai/config.json",
  "update": "notify",
  // "plugins": ["opencode-models-discovery@latest"],

  "providers": {
    "unsloth": {
      "name": "Unsloth (lan)",
      "package": "aisdk:@ai-sdk/openai-compatible",

      "settings": {
        "baseURL": "https://ai.quack.foo/v1",
        "apiKey": "{env:UNSLOTH_API_KEY}"
      },

      "models": {
        "qwen-3.6": {
          "name": "Qwen 3.6",
          "modelID": "unsloth/Qwen3.6-35B-A3B-MTP-GGUF:UD-Q4_K_XL"
        }
      }
    }
  },

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    {
      "action": "external_directory",
      "resource": "~/resources/**",
      "effect": "allow"
    },
    { "action": "edit", "resource": "~/resources/**", "effect": "deny" },

    { "action": "shell", "resource": "git commit *", "effect": "deny" },
    { "action": "shell", "resource": "git push *", "effect": "deny" },

    { "action": "provider.use", "resource": "*", "effect": "deny" },
    { "action": "provider.use", "resource": "unsloth", "effect": "allow" }
  ],

  "default_agent": "plan",
  "model": "unsloth/qwen-3.6",

  "compaction": {
    "keep": { "tokens": 8000 },
    "buffer": 20000
  },

  "formatter": {
    "deno-fmt": {
      "command": ["deno", "fmt", "$FILE"],
      "extensions": [
        ".ts",
        ".js",
        ".json",
        ".jsonc",
        ".json5",
        ".md",
        ".css",
        ".html"
      ]
    }
  }
}
