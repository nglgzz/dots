{
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",

  // Profile
  "window.newWindowProfile": "Default",

  // Title bar
  "workbench.layoutControl.enabled": false,
  "window.commandCenter": false,
  "window.menuBarVisibility": "toggle",

  // Tabs bar
  "workbench.editor.scrollToSwitchTabs": true,
  "workbench.editor.pinnedTabSizing": "compact",

  // Layout
  "workbench.activityBar.location": "top",
  "window.customTitleBarVisibility": "never",
  "breadcrumbs.symbolPath": "off",
  "window.zoomLevel": 2.5,

  // Color Theme
  "window.autoDetectColorScheme": true,
  "workbench.preferredDarkColorTheme": "Dark Modern",
  "workbench.preferredLightColorTheme": "Light+",

  "workbench.colorCustomizations": {
    "[Dark Modern]": {
      "editor.background": "#20201f",
      "editor.selectionForeground": "#20201f",

      "editorGroup.border": "#20292D",
      "editorGroup.dropBackground": "#20201f",
      "editorGroup.emptyBackground": "#20201f",
      "editorGroupHeader.noTabsBackground": "#20201f",
      "editorGroupHeader.tabsBorder": "#20201f",

      "statusBar.background": "#20201f",
      "statusBar.border": "#20201f",
      "panel.background": "#20201f",
      "editorRuler.foreground": "#20292D",
      "scrollbar.shadow": "#00000000"
    }
  },

  // Zen mode
  "zenMode.centerLayout": true,
  "zenMode.hideLineNumbers": true,
  "zenMode.fullScreen": false,

  // Editor
  "editor.formatOnSave": true,
  "editor.detectIndentation": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.suggestSelection": "first",
  "editor.inlineSuggest.enabled": true,
  "editor.fontFamily": "'Hack', 'Font Awesome 6 Free Solid'",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "alt",
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "diffEditor.ignoreTrimWhitespace": false,
  "git.blame.editorDecoration.enabled": false,

  // Languages
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "editor.defaultFormatter": "denoland.vscode-deno",

  "[typescript][javascript][json][jsonc][json5][html]": {
    "editor.rulers": [80, 100, 120]
  },
  "[markdown][dockerfile][shellscript][ignore][dotenv][properties][ansible]": {
    "editor.wordWrapColumn": 80,
    "editor.rulers": [80, 100]
  },
  "[c][cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.wordWrapColumn": 80,
    "editor.rulers": [80]
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.wordWrapColumn": 80,
    "editor.rulers": [80]
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "bradlc.vscode-tailwindcss"
  },
  "[caddyfile]": {
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },

  // Emmet
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },

  // Rewrap
  "rewrap.wrappingColumn": 80,

  // Explorer
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.excludeGitIgnore": true,

  // Files
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "files.associations": {
    ".env*": "toml"
  },

  // Git Changes
  "git.untrackedChanges": "separate",
  "git.showCommitInput": false,
  "git.showActionButton": {
    "commit": false,
    "publish": false,
    "sync": false
  },

  // Tasks & Debug
  "task.autoDetect": "off",
  "task.quickOpen.showAll": false,
  "task.quickOpen.history": 0,
  "debug.onTaskErrors": "abort",

  // Terminal
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  // Status bar
  "git.enableStatusBarSync": false,
  "debug.showInStatusBar": "never",

  // Copilot
  "inlineChat.lineNaturalLanguageHint": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "workbench.editor.empty.hint": "hidden",
  "chat.commandCenter.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  // Rust
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },

  // Ansible
  "ansible.lightspeed.enabled": false,
  "ansible.lightspeed.suggestions.enabled": false,

  // Extensions
  "extensions.ignoreRecommendations": true,
  "gitlens.mode.active": "zen",
  "gitlens.plusFeatures.enabled": false,
  "cmake.showConfigureWithDebuggerNotification": false,
  "todo.statistics.statusbar.enabled": false,

  // Other
  "cSpell.userWords": ["forgejo"],
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://docs.renovatebot.com": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai/config.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  }
}
