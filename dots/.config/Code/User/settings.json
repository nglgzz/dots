  "workbench.colorCustomizations": {
    "[GitHub Dark Colorblind (Beta)]": {
      // Dim rulers
      "editorRuler.foreground": "#20292D",

      // Dim borders
      "sideBarSectionHeader.border": "#222",
      "panel.border": "#222",

      // Remove borders
      "sideBar.border": "#00000000",
      "sideBarTitle.border": "#00000000",
      "titleBar.border": "#00000000",
      "tab.border": "#00000000",
      "editorGroup.border": "#00000000",
      "editorGroupHeader.tabsBorder": "#00000000",
      "statusBar.border": "#00000000",

      // Colorblind diffs
      "diffEditor.insertedLineBackground": "#1f6feb26",
      "diffEditor.insertedTextBackground": "#58a6ff4d",
      "diffEditor.removedLineBackground": "#b7610026",
      "diffEditor.removedTextBackground": "#ec8e2c4d",

      "editorGutter.addedBackground": "#388bfd66",
      "editorGutter.deletedBackground": "#ec8e2c4d",
      "editorGutter.modifiedBackground": "#bb800966",

      "gitDecoration.addedResourceForeground": "#58a6ff",
      "gitDecoration.conflictingResourceForeground": "#d47616",
      "gitDecoration.deletedResourceForeground": "#d47616",
      "gitDecoration.ignoredResourceForeground": "#6e7681",
      "gitDecoration.modifiedResourceForeground": "#d29922",
      "gitDecoration.submoduleResourceForeground": "#8b949e",
      "gitDecoration.untrackedResourceForeground": "#58a6ff"
    },
    "[Solarized Light]": {
      // Colorblind diffs
      "diffEditor.insertedLineBackground": "#b6e3ff4d",
      "diffEditor.insertedTextBackground": "#80ccff80",
      "diffEditor.removedLineBackground": "#e6ae654d",
      "diffEditor.removedTextBackground": "#f3933366",

      "editorGutter.addedBackground": "#54aeff66",
      "editorGutter.deletedBackground": "#f7993966",
      "editorGutter.modifiedBackground": "#d4a72c66",

      "gitDecoration.addedResourceForeground": "#0969da",
      "gitDecoration.conflictingResourceForeground": "#b35900",
      "gitDecoration.deletedResourceForeground": "#b35900",
      "gitDecoration.ignoredResourceForeground": "#6e7781",
      "gitDecoration.modifiedResourceForeground": "#9a6700",
      "gitDecoration.submoduleResourceForeground": "#57606a",
      "gitDecoration.untrackedResourceForeground": "#0969da"
    }
  },

  // Zen mode
  "zenMode.centerLayout": true,
  "zenMode.hideLineNumbers": true,
  "zenMode.fullScreen": false,

  // Editor
  "editor.fontFamily": "'Source Code Pro', 'Font Awesome 6 Free Solid'",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "alt",
  "editor.formatOnSave": true,
  "editor.detectIndentation": true,
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit"
  },
  "editor.suggestSelection": "first",
  "editor.inlineSuggest.enabled": true,
  "editor.wordSeparators": "`~!@#$%^&*()-=+[{]}\\|;:'\",.<>/?",
  "diffEditor.ignoreTrimWhitespace": false,
  "git.blame.editorDecoration.enabled": false,

  // Languages
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "editor.defaultFormatter": "denoland.vscode-deno",

  "[typescript][javascript][json][jsonc][json5][html]": {
    "editor.rulers": [80, 100, 120]
  },
  "[markdown][dockerfile][shellscript][ignore][dotenv][properties][ansible]": {
    "editor.wordWrapColumn": 80,
    "editor.rulers": [80, 100]
  },
  "[c][cpp]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.wordWrapColumn": 80,
    "editor.rulers": [80]
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.wordWrapColumn": 80,
    "editor.rulers": [80]
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "bradlc.vscode-tailwindcss"
  },
  "[caddyfile]": {
    "editor.insertSpaces": true,
    "editor.formatOnSave": false
  },

  // Emmet
  "emmet.triggerExpansionOnTab": true,
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },

  // Rewrap
  "rewrap.wrappingColumn": 80,

  // Explorer
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.excludeGitIgnore": true,

  // Files
  "files.trimTrailingWhitespace": true,
  "files.eol": "\n",
  "files.associations": {
    ".env*": "toml"
  },

  // Git Changes
  "git.untrackedChanges": "separate",
  "git.showCommitInput": false,
  "git.showActionButton": {
    "commit": false,
    "publish": false,
    "sync": false
  },

  // Tasks & Debug
  "task.autoDetect": "off",
  "task.quickOpen.showAll": false,
  "task.quickOpen.history": 0,
  "debug.onTaskErrors": "abort",

  // Terminal
  "terminal.integrated.shellIntegration.enabled": false,
  "terminal.integrated.enableMultiLinePasteWarning": "never",

  // Status bar
  "git.enableStatusBarSync": false,
  "debug.showInStatusBar": "never",

  // Copilot
  "inlineChat.lineNaturalLanguageHint": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "workbench.editor.empty.hint": "hidden",
  "chat.commandCenter.enabled": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",

  // Rust
  "rust-analyzer.inlayHints.chainingHints.enable": false,
  "rust-analyzer.inlayHints.typeHints.enable": false,
  "files.readonlyInclude": {
    "**/.cargo/registry/src/**/*.rs": true,
    "**/.cargo/git/checkouts/**/*.rs": true,
    "**/lib/rustlib/src/rust/library/**/*.rs": true
  },

  // Ansible
  "ansible.lightspeed.enabled": false,
  "ansible.lightspeed.suggestions.enabled": false,

  // Extensions
  "extensions.ignoreRecommendations": true,
  "gitlens.mode.active": "zen",
  "gitlens.plusFeatures.enabled": false,
  "gitlens.rebaseEditor.openOnPausedRebase": false,
  "cmake.showConfigureWithDebuggerNotification": false,
  "todo.statistics.statusbar.enabled": false,

  // Other
  "cSpell.userWords": ["forgejo"],
  "security.promptForLocalFileProtocolHandling": false,
  "json.schemaDownload.trustedDomains": {
    "https://developer.microsoft.com/json-schemas/": true,
    "https://docs.renovatebot.com": true,
    "https://json-schema.org/": true,
    "https://json.schemastore.org/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai/config.json": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://schemastore.azurewebsites.net/": true,
    "https://www.schemastore.org/": true
  }
}
